{
  "name": "vue-chm-reader",
  "version": "0.1.0",
  "description": "A browser-first CHM reader with a framework-agnostic TypeScript API and Vue 3 components.",
  "author": "yukaige",
  "homepage": "https://yukaige.github.io/vue-chm-reader/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukaige/vue-chm-reader.git"
  },
  "bugs": {
    "url": "https://github.com/yukaige/vue-chm-reader/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts --outDir demo-dist",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run build:demo",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "chm",
    "html-help",
    "vue",
    "reader",
    "ebook"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "chmlib-ts": "^0.3.0",
    "dompurify": "^3.2.6"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.20",
    "vue-tsc": "^3.0.6"
  },
  "engines": {
    "node": ">=20"
  }
}
